# PhotoPrint: static app + reverse proxy of /api to the bridge.
# ${BRIDGE_URL} is filled in from the environment when the container starts.
server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BRIDGE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection '';

        # /api/events is a Server-Sent Events stream: deliver every event right away.
        proxy_buffering off;
        proxy_cache off;
        # /api/print answers when the printer finishes (minutes); the event stream never ends.
        proxy_read_timeout 1h;
        proxy_send_timeout 10m;
        # Print files (JPEG, up to ~2-3 MB at maximum quality).
        client_max_body_size 32m;
    }

    # Built files have a hash in their name: cache them for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
